# Placeholder development credentials. Replace locally; never commit .env.
POSTGRES_USER=openplans
POSTGRES_PASSWORD=replace_this_placeholder
POSTGRES_DB=openplans
API_PORT=3000
DB_PORT=5432
# Postgres memory budget (not host RAM): whole m/g units, 512m..256g.
OPENPLANS_DB_MEMORY=1g
# Search response cache: bounded local LRU by default; off disables all backends.
OPENPLANS_API_CACHE=on
OPENPLANS_API_CACHE_MB=64
# Optional shared cache: enable compose profile cache AND set this URL.
# OPENPLANS_CACHE_URL=redis://cache:6379
OPENPLANS_CACHE_MEMORY=256mb
# Placeholder only. Set a private, nonempty token locally for personalized requests.
OPENPLANS_API_TOKEN=replace_this_api_token_placeholder
# Key the compatibility API expects in the X-Api-Key header (/compat/v1/*).
OPENPLANS_COMPAT_API_KEY=replace_this_compat_key_placeholder
# Optional extra credential header, in addition to X-Api-Key. Empty means disabled.
# Must be a single RFC 7230 token; invalid names prevent API startup.
# OPENPLANS_COMPAT_KEY_HEADER=X-Reference-Key
# Optional external captured reference responses for tests; skipped when unset.
# OPENPLANS_REFERENCE_CAPTURES_DIR=/absolute/reference-captures
# Shared immutable downloads and writable reports; keep this outside the repo.
# OPENPLANS_DATA_DIR=/var/lib/openplans

# Optional CMS live ZIP lookup key; leave unset to use only public bulk sources.
# CMS_API_KEY=

# MCP catalog is anonymous; off removes /mcp. Separate private token for estimates.
OPENPLANS_MCP=on
# OPENPLANS_MCP_TOKEN=
# Share a private random cursor secret across replicas to preserve cursors.
# OPENPLANS_MCP_CURSOR_SECRET=
# Comma-separated exact authorities (host:port) and exact origins (scheme://host:port).
# Defaults permit localhost authorities and origins on PORT (3000).
# OPENPLANS_MCP_ALLOWED_HOSTS=127.0.0.1:3000,localhost:3000
# OPENPLANS_MCP_ALLOWED_ORIGINS=http://localhost:3000
# Only these exact socket-peer addresses may supply X-Forwarded-For.
# Configure each trusted proxy to overwrite incoming forwarding headers.
# OPENPLANS_TRUST_PROXY=127.0.0.1
# Local stdio only: explicitly grant household estimation.
# OPENPLANS_MCP_ALLOW_PERSONALIZED=1
