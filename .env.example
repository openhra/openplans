# Placeholder development credentials. Replace locally; never commit .env.
POSTGRES_USER=openplans
POSTGRES_PASSWORD=replace_this_placeholder
POSTGRES_DB=openplans
API_PORT=3000
DB_PORT=5432
# Postgres memory budget (not host RAM): whole m/g units, 512m..256g.
OPENPLANS_DB_MEMORY=1g
# Search response cache: bounded local LRU by default; off disables all backends.
OPENPLANS_API_CACHE=on
OPENPLANS_API_CACHE_MB=64
# Optional shared cache: enable compose profile cache AND set this URL.
# OPENPLANS_CACHE_URL=redis://cache:6379
OPENPLANS_CACHE_MEMORY=256mb
# Public API access is on by default. Optional data sources have separate opt-ins.
# Quotes by age and ZIP (POST /v1/quotes). Set off to disable them.
OPENPLANS_PUBLIC_QUOTING=on
# Household quotes, the benchmark and ICHRA checks are open with no token.
# Set a private token to require Bearer auth, or set off with no token to disable them.
OPENPLANS_PUBLIC_HOUSEHOLD=on
# OPENPLANS_API_TOKEN=
# The compatibility API (/compat/v1/*) is open with no key.
# Set a key to require it in X-Api-Key, or set off with no key to disable it.
OPENPLANS_PUBLIC_COMPAT=on
# OPENPLANS_COMPAT_API_KEY=
# Optional extra credential header, in addition to X-Api-Key. Empty means disabled.
# Must be a single RFC 7230 token; invalid names prevent API startup.
# OPENPLANS_COMPAT_KEY_HEADER=X-Client-Key
# Off by default. "on" drops catastrophic plans for applicants aged 30 or older
# unless the search sends catastrophic_exemption: true. See 45 CFR 156.155(a).
# OPENPLANS_COMPAT_CATASTROPHIC_AGE_RULE=on
# Off by default. "compact" serves short benefit phrases built from the tier 1 and
# out-of-network cells on /compat/v1. Native routes keep the full cells.
# OPENPLANS_COMPAT_BENEFIT_TEXT=compact
# Shared immutable downloads and writable reports; keep this outside the repo.
# OPENPLANS_DATA_DIR=/var/lib/openplans

# Optional CMS live ZIP lookup and opt-in coverage fallback key.
# Leave unset for public bulk sources only. Coverage needs the switches below.
# CMS_API_KEY=
# OPENPLANS_CMS_FALLBACK=off
# OPENPLANS_CMS_FALLBACK_QUOTES=off

# Every MCP tool is anonymous, household quotes included; off removes /mcp.
# A private token restricts quote_premiums and check_ichra_affordability to Bearer callers.
OPENPLANS_MCP=on
# OPENPLANS_MCP_TOKEN=
# Share a private random cursor secret across replicas to preserve cursors.
# OPENPLANS_MCP_CURSOR_SECRET=
# Plugins to load, comma-separated. The status plugin's operator routes need a private
# token of at least 32 random characters.
# OPENPLANS_PLUGINS=@openplans/plugin-status
# OPENPLANS_OPERATOR_TOKEN=
# Comma-separated exact authorities (host:port) and exact origins (scheme://host:port).
# Defaults permit localhost authorities and origins on PORT (3000).
# OPENPLANS_MCP_ALLOWED_HOSTS=127.0.0.1:3000,localhost:3000
# OPENPLANS_MCP_ALLOWED_ORIGINS=http://localhost:3000
# Only these exact socket-peer addresses may supply X-Forwarded-For.
# Configure each trusted proxy to overwrite incoming forwarding headers.
# OPENPLANS_TRUST_PROXY=127.0.0.1
# Stdio inherits public household access and the absence of an MCP token.
# 1 explicitly grants household tools; 0 withholds them.
# OPENPLANS_MCP_ALLOW_PERSONALIZED=0

# Optional operator geocoder. Unset URL means no requests.
# HTTPS is required except for a loopback test server. Values in braces are URL-encoded.
# Supported values: {address}, {line1}, {line2}, {city}, {state}, {zip}, {key}.
# OPENPLANS_GEOCODER_URL=https://geocoder.example/search?q={address}&key={key}
# OPENPLANS_GEOCODER_KEY=
# Dot-separated JSON paths support array indexes, such as results.0.latitude.
# OPENPLANS_GEOCODER_LAT_PATH=latitude
# OPENPLANS_GEOCODER_LON_PATH=longitude
# OPENPLANS_GEOCODER_COUNTY_PATH=county_fips
# Minimum interval between requests, in milliseconds. Must be at least 1000.
# OPENPLANS_GEOCODER_INTERVAL_MS=1000
# Set to 1 only if the operator's provider permits storage of returned coordinates.
# Points stay in OPENPLANS_DATA_DIR/operator-geocoder, outside SQL dumps and source exports.
# Serving stored operator points also requires OPENPLANS_API_CACHE=off.
# OPENPLANS_GEOCODER_STORE=0

# Optional self-hosted Nominatim. Literal loopback IP only; no public-service fallback.
# OPENPLANS_OPEN_GEOCODER_URL=http://127.0.0.1:58080
# Regional deployment variables, used by src/ingest/geocode/geocoder.sh:
# OPENPLANS_GEOCODER_STATE=tx
# OPENPLANS_GEOCODER_SNAPSHOT=261107
# OPENPLANS_GEOCODER_PORT=58080

# Native Node entry points do not read .env. Export variables in their shell.
# Compose constructs DATABASE_URL and sets PORT=3000, HOST=0.0.0.0 internally.
# DATABASE_URL=postgresql://openplans:replace_this_placeholder@127.0.0.1:5432/openplans
# PORT=3000
# HOST=127.0.0.1
# Compose image and raw-cache mount settings.
# OPENPLANS_IMAGE=openplans:local
# OPENPLANS_RAW_READ_ONLY=true

# Publisher access. Paths inside the worker container must use /data/work/.
# OPENPLANS_ACCESS_MANIFEST=/data/work/access/operator.json
# OPENPLANS_SHIPPED_ACCESS=on
# OPENPLANS_PROJECT_URL=https://plans.openhra.com/
# OPENPLANS_EGRESS_COUNTRY=US
# Optional bound egress record; its exact SHA-256 is required when the path is set.
# OPENPLANS_EGRESS_FILE=/absolute/path/to/egress-record.json
# OPENPLANS_EGRESS_SHA256=

# Policy-gated serving and CSV recovery. Both are off by default.
# OPENPLANS_MEDICARE_PART_D=off
# OPENPLANS_GA_QUOTE_RECOVERY=off

# Native developer/check runners only. Leave unset for the standard worker.
# OPENPLANS_PGLITE_DIR=/absolute/path/to/development-db
# OPENPLANS_PUF_DB=/absolute/path/to/puf-db
# OPENPLANS_FORMULARY_DB=/absolute/path/to/formulary-db
# OPENPLANS_PROVIDER_DB=/absolute/path/to/provider-db
# OPENPLANS_FORMULARY_REPORT=p2c-formulary-realdata.json
# OPENPLANS_QHP_DB=/absolute/path/to/qhp-db
# OPENPLANS_QHP_DATABASE_URL=
# OPENPLANS_QHP_CATALOG_DB=/absolute/path/to/catalog-db
# OPENPLANS_QHP_MIGRATIONS_DIRECTORY=/absolute/path/to/migrations
# OPENPLANS_QHP_STATE=TX
# OPENPLANS_QHP_YEAR=2026
# OPENPLANS_QHP_ISSUER=
# OPENPLANS_QHP_ENRICHMENT=0
# OPENPLANS_QHP_RESUME=0
# OPENPLANS_QHP_RUN_BUDGET_MS=1800000
# OPENPLANS_QHP_REPORT_PREFIX=p6a-postgres
# Optional external regression fixtures. Unset checks skip these inputs.
# OPENPLANS_REFERENCE_CAPTURES_DIR=/absolute/path/to/fixtures

# Publication checks only. Supply an external nonempty policy to audit an export.
# OPENPLANS_DENYLIST_FILE=/absolute/path/to/publication-policy.txt

# Docker smoke checks only. Smoke requires OPENPLANS_PUBLIC_HOUSEHOLD=off for its auth control.
# OPENPLANS_COMPOSE_PROJECT=openplans-h2
# OPENPLANS_SMOKE_TMPDIR=/absolute/path/to/docker-visible/scratch
