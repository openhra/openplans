{
  "name": "@openplans/blob-s3",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@openplans/plugin-sdk": "0.2.0"
  },
  "peerDependencies": {
    "hono": "4.13.16",
    "zod": "4.6.7"
  },
  "openplansPlugin": {
    "apiVersion": "0.2",
    "kinds": [
      "blobStores"
    ],
    "capabilities": {
      "secrets": [
        "OPENPLANS_BLOB_S3_ENDPOINT",
        "OPENPLANS_BLOB_S3_REGION",
        "OPENPLANS_BLOB_S3_BUCKET",
        "OPENPLANS_BLOB_S3_ACCESS_KEY_ID",
        "OPENPLANS_BLOB_S3_SECRET_ACCESS_KEY",
        "OPENPLANS_BLOB_S3_SESSION_TOKEN"
      ],
      "writes": [
        "blobs"
      ]
    }
  }
}
