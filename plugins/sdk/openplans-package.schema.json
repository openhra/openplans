        "kind": {
          "type": "string",
          "const": "data"
        },
        "data": {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "const": "original-public-files"
            },
            "files": {
              "minItems": 1,
              "maxItems": 5000,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240,
                    "pattern": "^(?!.*(?:^|\\/)[nN][oO][dD][eE]_[mM][oO][dD][uU][lL][eE][sS](?:\\/|$))(?!.*\\.[nN][oO][dD][eE]$)[A-Za-z0-9_@+-][A-Za-z0-9_@+.-]*(?:\\/[A-Za-z0-9_@+-][A-Za-z0-9_@+.-]*)*$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "expandedBytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "origin": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string",
                        "maxLength": 2048,
                        "pattern": "^https:\\/\\/[^/?#@]+(?:\\/[^?#]*)?$"
                      },
                      "sha256": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "retrievedAt": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                      },
                      "admission": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 240,
                            "pattern": "^(?!.*(?:^|\\/)[nN][oO][dD][eE]_[mM][oO][dD][uU][lL][eE][sS](?:\\/|$))(?!.*\\.[nN][oO][dD][eE]$)[A-Za-z0-9_@+-][A-Za-z0-9_@+.-]*(?:\\/[A-Za-z0-9_@+-][A-Za-z0-9_@+.-]*)*$"
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          }
                        },
                        "required": ["path", "sha256"],
                        "additionalProperties": false
                      }
                    },
                    "required": ["url", "retrievedAt", "admission"],
                    "additionalProperties": false
                  },
                  "redistribution": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "type": "string",
                        "const": "allowed"
                      },
                      "termsUrl": {
                        "type": "string",
                        "maxLength": 2048,
                        "pattern": "^https:\\/\\/[^/?#@]+(?:\\/[^?#]*)?$"
                      },
                      "evidence": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 240,
                            "pattern": "^(?!.*(?:^|\\/)[nN][oO][dD][eE]_[mM][oO][dD][uU][lL][eE][sS](?:\\/|$))(?!.*\\.[nN][oO][dD][eE]$)[A-Za-z0-9_@+-][A-Za-z0-9_@+.-]*(?:\\/[A-Za-z0-9_@+-][A-Za-z0-9_@+.-]*)*$"
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          }
                        },
                        "required": ["path", "sha256"],
                        "additionalProperties": false
                      }
                    },
                    "required": ["status", "termsUrl", "evidence"],
                    "additionalProperties": false
                  },
                  "chunks": {
                    "minItems": 1,
                    "maxItems": 4096,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "bytes": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 67108864
                        }
                      },
                      "required": ["sha256", "bytes"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "path",
                  "bytes",
                  "expandedBytes",
                  "sha256",
                  "origin",
                  "redistribution",
                  "chunks"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": ["format", "files"],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "name",
        "version",
        "summary",
        "licence",
        "attribution",
        "apiVersion",
        "kinds",
        "capabilities",
        "hostPeers",
        "bundledDependencies",
        "planYears",
        "provenance",
        "kind",
        "data"
      ],
      "additionalProperties": false
    }
  ]
}
