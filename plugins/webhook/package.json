{
  "name": "@openplans/plugin-webhook",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@openplans/plugin-sdk": "0.2.0"
  },
  "peerDependencies": {
    "hono": "4.13.16",
    "zod": "4.6.7"
  },
  "openplansPlugin": {
    "apiVersion": "0.2",
    "kinds": [
      "events"
    ],
    "capabilities": {
      "network": [],
      "secrets": [
        "OPENPLANS_WEBHOOK_URL",
        "OPENPLANS_WEBHOOK_SECRET"
      ]
    },
    "networkFromEnv": "OPENPLANS_WEBHOOK_HOST"
  }
}
