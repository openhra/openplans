{
  "name": "openplans",
  "version": "0.4.7",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "worker": "./dist/worker/cli.js",
    "openplans-mcp": "./dist/mcp/stdio.js"
  },
  "scripts": {
    "format": "prettier --ignore-path .prettierignore --write .",
    "format:check": "prettier --ignore-path .prettierignore --check .",
    "lint": "eslint . --max-warnings 0 && node scripts/lint-baseline.mjs",
    "check:lint-setup": "node scripts/lint-setup-selftest.mjs",
    "build": "npm run build:plugins && tsc -p tsconfig.build.json",
    "build:sdk": "npm run build -w @openplans/plugin-sdk",
    "build:plugins": "npm run build:sdk && npm run build --workspaces --if-present",
    "pretypecheck": "npm run build:plugins",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/api/server.js",
    "api:pglite": "node dist/api/pglite.js",
    "worker": "node dist/worker/cli.js",
    "worker:geo:pglite": "node dist/ingest/geo/pglite.js ingest geo",
    "fixtures:geo": "npm run build && node tests/fixtures/geo/regenerate.mjs",
    "check:extraction": "node scripts/check-extraction.mjs",
    "check:publisher-review": "node scripts/check-publisher-review.mjs",
    "worker:puf:pglite": "node dist/ingest/puf/import-pglite.js",
    "fixtures:puf:import": "python3 tests/fixtures/puf/import/regenerate.py",
    "lint:prune": "eslint . --max-warnings 0 --prune-suppressions && node scripts/lint-baseline.mjs --prune"
  },
  "dependencies": {
    "@hono/node-server": "1.19.18",
    "@modelcontextprotocol/hono": "2.0.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@openplans/plugin-sdk": "0.1.0",
    "@openplans/source-cms-marketplace-api": "0.1.0",
    "@openplans/source-nucc-taxonomy": "0.1.0",
    "hono": "4.13.16",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@eslint/js": "9.39.5",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.19.15",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "workspaces": [
    "plugins/*"
  ]
}
